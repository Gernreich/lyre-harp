# How every shipped SVG and page in this repository is drawn. Checked by
# lasermade-tools' repro-svg; $OUT is where the file must be written.
#
# The generator is lyre_harp.rs, here since 2026-10-14 and Rust since 2026-11-07
# (Python until then). It uses the panel, slot and sheet code of the
# ribbon_bore library in the swept-curve checkout beside this one, so these
# commands expect the two side by side, built with cargo build --release. --out=
# and --test= name their own files from the stem they are given, so those
# commands write into $OUT's directory and the tool compares the file it asked
# for.

# --- the five build sheets, all written by one --out= run ---
lyre-harp-bore30-188x400mm/cut-files/lyre-harp-bore30-188x400mm-narrow-cheek-a-cut-files.svg :: target/release/lyre_harp --out=$(dirname $OUT)/lyre-harp-bore30-188x400mm-narrow.svg
lyre-harp-bore30-188x400mm/cut-files/lyre-harp-bore30-188x400mm-narrow-cheek-b-cut-files.svg :: target/release/lyre_harp --out=$(dirname $OUT)/lyre-harp-bore30-188x400mm-narrow.svg
lyre-harp-bore30-188x400mm/cut-files/lyre-harp-bore30-188x400mm-narrow-panels-cut-files.svg :: target/release/lyre_harp --out=$(dirname $OUT)/lyre-harp-bore30-188x400mm-narrow.svg
lyre-harp-bore30-188x400mm/cut-files/lyre-harp-bore30-188x400mm-narrow-hitch-block-cut-files.svg :: target/release/lyre_harp --out=$(dirname $OUT)/lyre-harp-bore30-188x400mm-narrow.svg
lyre-harp-bore30-188x400mm/cut-files/lyre-harp-bore30-188x400mm-narrow-tuning-block-cut-files.svg :: target/release/lyre_harp --out=$(dirname $OUT)/lyre-harp-bore30-188x400mm-narrow.svg

# --- the test sheets and the back-face engraving ---
lyre-harp-bore30-188x400mm/cut-files/KERF-TEST-3mm-ply.svg :: target/release/lyre_harp --kerf-test=$OUT
lyre-harp-bore30-188x400mm/cut-files/lyre-harp-bore30-188x400mm-narrow-FIT-LADDER-cut-files.svg :: target/release/lyre_harp --ladder=$OUT
lyre-harp-bore30-188x400mm/cut-files/lyre-harp-bore30-188x400mm-narrow-test-arch-4toA-cut-files.svg :: target/release/lyre_harp --test=$(dirname $OUT)/lyre-harp-bore30-188x400mm-narrow.svg
lyre-harp-bore30-188x400mm/cut-files/lyre-harp-bore30-188x400mm-narrow-cheek-a-BACK-FACE-numbers-engrave-only.svg :: target/release/lyre_harp --back-numbers=$OUT

# --- the review drawing and the 3D page, from the same build() ---
lyre-harp-drawing.svg :: target/release/lyre_harp --drawing=$OUT
lyre-harp-bore30-188x400mm/lyre-harp-bore30-188x400mm.html :: target/release/lyre_harp --render=$OUT

# --- display renderings, never cut files ---
previews/lyre-harp-bore30-188x400mm-narrow-cheek-a-cut-files.svg :: ../lasermade-tools/target/release/make-preview lyre-harp-bore30-188x400mm/cut-files/lyre-harp-bore30-188x400mm-narrow-cheek-a-cut-files.svg $OUT
previews/lyre-harp-bore30-188x400mm-narrow-cheek-b-cut-files.svg :: ../lasermade-tools/target/release/make-preview lyre-harp-bore30-188x400mm/cut-files/lyre-harp-bore30-188x400mm-narrow-cheek-b-cut-files.svg $OUT
previews/lyre-harp-bore30-188x400mm-narrow-panels-cut-files.svg :: ../lasermade-tools/target/release/make-preview lyre-harp-bore30-188x400mm/cut-files/lyre-harp-bore30-188x400mm-narrow-panels-cut-files.svg $OUT
previews/lyre-harp-bore30-188x400mm-narrow-hitch-block-cut-files.svg :: ../lasermade-tools/target/release/make-preview lyre-harp-bore30-188x400mm/cut-files/lyre-harp-bore30-188x400mm-narrow-hitch-block-cut-files.svg $OUT
previews/lyre-harp-bore30-188x400mm-narrow-tuning-block-cut-files.svg :: ../lasermade-tools/target/release/make-preview lyre-harp-bore30-188x400mm/cut-files/lyre-harp-bore30-188x400mm-narrow-tuning-block-cut-files.svg $OUT

# --- the published page, built from README.md ---
index.html :: ../lasermade-tools/target/release/md2html README.md $OUT

# --- the SolidCraft design: its script, the design (slimmed by sc-slim so it
# is the same every run), and the STEP file SolidCraft builds from it ---
lyre-harp-bore30-188x400mm/solidcraft/lyre-harp-bore30-188x400mm.solidcraft.json :: target/release/lyre_harp --solidcraft=$(dirname $OUT)
lyre-harp-bore30-188x400mm/solidcraft/lyre-harp-bore30-188x400mm.sc :: target/release/lyre_harp --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/lyre-harp-bore30-188x400mm.solidcraft.json --save $OUT --quiet && ../lasermade-tools/target/release/sc-slim $OUT
lyre-harp-bore30-188x400mm/step/lyre-harp-bore30-188x400mm.step :: target/release/lyre_harp --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/lyre-harp-bore30-188x400mm.solidcraft.json --out $OUT --quiet
